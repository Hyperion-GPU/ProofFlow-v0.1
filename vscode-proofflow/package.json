{
  "name": "proofflow",
  "displayName": "ProofFlow",
  "description": "Local-first audit layer for AI coding agents — review, gate, and trace every AI change",
  "version": "0.1.5",
  "publisher": "hyperion-gpu",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Hyperion-GPU/ProofFlow-v0.1"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Testing"
  ],
  "keywords": [
    "ai",
    "audit",
    "codex",
    "code-review",
    "agent-safety",
    "mcp"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "proofflow.reviewLastChanges",
        "title": "ProofFlow: Review with AgentGuard",
        "icon": "$(shield)"
      },
      {
        "command": "proofflow.scanFolder",
        "title": "ProofFlow: Scan with ProofFlow"
      },
      {
        "command": "proofflow.approveAction",
        "title": "ProofFlow: Approve Gate & Execute"
      },
      {
        "command": "proofflow.refresh",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "proofflow.showLogs",
        "title": "ProofFlow: Show Logs"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "proofflow-sidebar",
          "title": "ProofFlow",
          "icon": "resources/icons/proofflow.svg"
        }
      ]
    },
    "views": {
      "proofflow-sidebar": [
        {
          "id": "proofflow.casesView",
          "name": "Cases"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "proofflow.casesView",
        "contents": "No cases found.\n[Review Last AI Changes](command:proofflow.reviewLastChanges)\n[Scan Current Folder](command:proofflow.scanFolder)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "proofflow.refresh",
          "when": "view == proofflow.casesView",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "proofflow.scanFolder",
          "when": "explorerResourceIsFolder",
          "group": "navigation@80"
        },
        {
          "command": "proofflow.reviewLastChanges",
          "group": "navigation@81"
        }
      ],
      "view/item/context": [
        {
          "command": "proofflow.approveAction",
          "when": "view == proofflow.casesView && viewItem == action",
          "group": "inline"
        }
      ]
    },
    "configuration": {
      "title": "ProofFlow",
      "properties": {
        "proofflow.backendUrl": {
          "type": "string",
          "default": "http://127.0.0.1:8787",
          "description": "URL of the ProofFlow backend server"
        },
        "proofflow.apiKey": {
          "type": "string",
          "default": "",
          "description": "Optional API key for authentication"
        },
        "proofflow.autoRefresh": {
          "type": "boolean",
          "default": true,
          "description": "Automatically poll backend every 10 seconds"
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "test": "node test/run-tests.mjs",
    "watch": "node esbuild.mjs --watch",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@types/node": "^25.6.2",
    "@types/vscode": "^1.120.0",
    "@vscode/vsce": "^3.9.1",
    "esbuild": "^0.28.0",
    "typescript": "^6.0.3"
  }
}
